# Non-secret settings for the user-specified private DEMO domain.
# Set credentials in the chosen hosting platform's secret store, not Git.
NEXA_WORKSPACE_MODE=private_demo
NEXA_WORKSPACE_ORIGIN=https://nexa-mk.voltwok.com
NEXA_DEMO_AUTH_USERNAME=
NEXA_DEMO_AUTH_PASSWORD=
# Private backend URL and a token for an isolated DEMO tenant.
NEXA_API_URL=
NEXA_API_TOKEN=
NEXA_AI_ENABLED=false
